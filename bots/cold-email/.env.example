# ============================================
# PROFESSIONAL COLD EMAIL SYSTEM - CONFIGURATION
# ============================================
# Copy this file to .env and fill in your actual credentials

# ============================================
# AI/LLM API KEYS
# ============================================

# Google Gemini API (for website screenshot analysis - OPTIONAL)
# Get from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# OpenAI API (for email generation - REQUIRED)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# EMAIL SENDING (SMTP) - REQUIRED
# ============================================

# SMTP Server Configuration
# Examples:
#   Gmail: smtp.gmail.com (port 587)
#   Outlook: smtp-mail.outlook.com (port 587)
#   SendGrid: smtp.sendgrid.net (port 587)
#   Mailgun: smtp.mailgun.org (port 587)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here

# For Gmail: Use App Password, not your regular password
# https://support.google.com/accounts/answer/185833

# ============================================
# EMAIL RECEIVING (IMAP) - REQUIRED for response tracking
# ============================================

# IMAP Server Configuration
# Examples:
#   Gmail: imap.gmail.com
#   Outlook: outlook.office365.com

IMAP_HOST=imap.gmail.com
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_app_specific_password_here

# ============================================
# SPAM AVOIDANCE & RATE LIMITING
# ============================================

# Daily email sending limit (default: 50)
# Recommended: Start low (20-30) and increase gradually
DAILY_EMAIL_LIMIT=50

# Hourly email limit (default: 10)
# Prevents bursts that trigger spam filters
HOURLY_EMAIL_LIMIT=10

# Delay between emails (seconds)
# Randomized between MIN and MAX to look human
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=300

# Warm-up mode (true/false)
# If true, starts with 10 emails/day and increases by 5 each day
# Recommended for new email accounts
WARM_UP_MODE=false
WARM_UP_DAILY_INCREASE=5

# ============================================
# SENDING TIME WINDOWS
# ============================================

# Only send during business hours (9 AM - 5 PM)
SEND_HOURS_START=9
SEND_HOURS_END=17

# Only send on weekdays (Mon-Fri)
SEND_WEEKDAYS_ONLY=true

# ============================================
# SENDER INFORMATION
# ============================================

# Your name and company (used in email signatures)
SENDER_NAME=Your Name
SENDER_COMPANY=Your Web Design Agency
PORTFOLIO_LINK=https://yourportfolio.com

# ============================================
# NOTION INTEGRATION (OPTIONAL)
# ============================================

# Notion API for tracking positive responses
# Get from: https://www.notion.so/my-integrations
NOTION_API_KEY=your_notion_api_key_here
NOTION_DATABASE_ID=your_notion_database_id_here

# ============================================
# NOTES & BEST PRACTICES
# ============================================
#
# 1. EMAIL AUTHENTICATION:
#    - Set up SPF, DKIM, and DMARC for your sending domain
#    - Use a dedicated sending domain (not your main business domain)
#    - Verify your domain with your email provider
#
# 2. WARM-UP STRATEGY:
#    - New email account? Enable WARM_UP_MODE=true
#    - Start with 10-20 emails/day for the first week
#    - Gradually increase over 2-3 weeks
#    - Monitor bounce rates (<2%) and complaint rates (<0.1%)
#
# 3. CONTENT QUALITY:
#    - Personalize every email
#    - Avoid spam trigger words (FREE, GUARANTEED, ACT NOW, !!!)
#    - Keep text-to-image ratio at 80:20
#    - Don't include images in first email
#
# 4. LIST HYGIENE:
#    - Only email valid, opted-in leads
#    - Remove bounced emails immediately
#    - Respect unsubscribe requests
#
# 5. LEGAL COMPLIANCE:
#    - Follow CAN-SPAM Act (US)
#    - Follow GDPR (EU)
#    - Include physical address in emails
#    - Provide clear unsubscribe method
#
# 6. MONITORING:
#    - Check spam score: mail-tester.com
#    - Monitor sender reputation: senderscore.org
#    - Track deliverability rates
#    - Adjust strategy based on metrics
#
# ============================================
